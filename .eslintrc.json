{
  "env": {
    "browser": true,
    "es2022": true,
    "webextensions": true
  },
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "script"
  },
  "overrides": [
    {
      "files": ["rollup.config.js", "vitest.config.js", "src/**/*.js"],
      "env": {
        "node": true,
        "browser": false
      },
      "parserOptions": {
        "sourceType": "module"
      }
    }
  ],
  "rules": {
    "no-eval": "error",
    "no-implied-eval": "error",
    "no-new-func": "error",
    "no-script-url": "error",
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
    "no-undef": "error",
    "no-var": "warn",
    "prefer-const": "warn",
    "eqeqeq": ["error", "always"],
    "no-throw-literal": "error",
    "no-self-compare": "error",
    "no-template-curly-in-string": "warn"
  },
  "globals": {
    "chrome": "readonly",
    "browser": "readonly",
    "importScripts": "readonly",
    "WebSuddhi": "readonly"
  },
  "ignorePatterns": [
    "_metadata/",
    "dist/",
    "icons/convert-icons.js",
    "safari*/",
    "node_modules/"
  ]
}
