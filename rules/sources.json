{
  "version": 1,
  "description": "Upstream sources for WebSuddhi curated blocklists. Run: node scripts/build-blocklists.mjs",
  "sources": [
    {
      "id": "easylist",
      "name": "EasyList",
      "url": "https://easylist.to/easylist/easylist.txt",
      "category": "ads",
      "syntax": "adblock",
      "skipBareHosts": true,
      "cosmetic": true,
      "enabled": true,
      "note": "Path, scoped and exception rules (first-party ads) plus site-specific element hiding. Plain host blocks are left to the DNS lists."
    },
    {
      "id": "easyprivacy",
      "name": "EasyPrivacy",
      "url": "https://easylist.to/easylist/easyprivacy.txt",
      "category": "ads",
      "syntax": "adblock",
      "skipBareHosts": true,
      "cosmetic": true,
      "maxDomains": 4000,
      "enabled": true,
      "note": "Tracking pixels and beacons served from a site's own paths."
    },
    {
      "id": "hagezi-pro",
      "name": "HaGeZi Pro DNS Blocklist",
      "url": "https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@latest/adblock/pro.txt",
      "category": "ads",
      "maxDomains": 15000,
      "enabled": true
    },
    {
      "id": "hagezi-tif-mini",
      "name": "HaGeZi Threat Intelligence Feeds Mini",
      "url": "https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@latest/adblock/tif.mini.txt",
      "category": "security",
      "maxDomains": 8000,
      "enabled": true
    },
    {
      "id": "hagezi-fake",
      "name": "HaGeZi Fake/Scam DNS Blocklist",
      "url": "https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@latest/adblock/fake.txt",
      "category": "security",
      "maxDomains": 3000,
      "enabled": true
    },
    {
      "id": "hagezi-dyndns",
      "name": "HaGeZi DynDNS Blocklist",
      "url": "https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@latest/adblock/dyndns.txt",
      "category": "security",
      "enabled": true
    },
    {
      "id": "hagezi-popupads",
      "name": "HaGeZi Pop-Up Ads",
      "url": "https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@latest/adblock/popupads.txt",
      "category": "ads",
      "maxDomains": 5000,
      "enabled": true
    },
    {
      "id": "adguard-dns",
      "name": "AdGuard DNS Filter",
      "url": "https://adguardteam.github.io/AdGuardSDNSFilter/Filters/filter.txt",
      "category": "ads",
      "maxDomains": 10000,
      "enabled": true
    },
    {
      "id": "phishing-urls",
      "name": "Phishing URL Blocklist",
      "url": "https://malware-filter.gitlab.io/malware-filter/phishing-filter-ag.txt",
      "category": "security",
      "maxDomains": 3000,
      "enabled": true
    },
    {
      "id": "hagezi-spam-tlds",
      "name": "HaGeZi Spam TLDs",
      "url": "https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@latest/adblock/spam-tlds-adblock.txt",
      "category": "spam",
      "enabled": true
    }
  ],
  "categories": {
    "ads": {
      "idStart": 100001,
      "description": "Advertising and tracker domains"
    },
    "security": {
      "idStart": 150001,
      "description": "Malware, phishing, scam, DynDNS"
    },
    "spam": {
      "idStart": 200001,
      "description": "Spam TLDs and nuisance domains"
    }
  },
  "settings": {
    "maxRulesPerFile": 8000,
    "totalBudget": 29500,
    "resourceTypes": [
      "script",
      "image",
      "xmlhttprequest",
      "sub_frame",
      "stylesheet",
      "font",
      "media",
      "websocket",
      "ping",
      "other"
    ],
    "categoryPriority": [
      "security",
      "spam",
      "ads"
    ],
    "budgetNote": "Chrome only guarantees 30,000 static declarativeNetRequest rules per extension; anything above depends on other installed extensions. Safari allows far more."
  }
}
