  "categories": {
    "ads": { "idStart": 100001, "description": "Advertising and tracker domains" },
    "security": { "idStart": 150001, "description": "Malware, phishing, scam, DynDNS" },
    "spam": { "idStart": 200001, "description": "Spam TLDs and nuisance domains" }
