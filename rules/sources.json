      "maxDomains": 10000,
      "enabled": true
    },
    {
      "id": "hagezi-fake",
      "name": "HaGeZi Fake/Scam DNS Blocklist",
      "url": "https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@latest/adblock/fake.txt",
      "category": "security",
      "maxDomains": 5000,
      "enabled": true
    },
    {
      "id": "hagezi-dyndns",
      "name": "HaGeZi DynDNS Blocklist",
