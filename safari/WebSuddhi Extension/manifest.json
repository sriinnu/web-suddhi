{
  "manifest_version": 2,
  "name": "WebSuddhi",
  "version": "2.2.0",
  "description": "Block ads, remove paywalls, strip trackers, and clean up any website. Privacy-first, no tracking.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "../background/background.js",
      "../background/network-blocker.js",
      "../background/url-cleaner.js",
      "../background/stats-manager.js",
      "../background/privacy.js",
      "../background/filter-lists.js"
    ],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["../content/ad-blocker.js"],
      "css": ["../content/ad-blocker.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["../content/cookie-consent.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["../content/annoyance-blocker.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_popup": "../popup/popup.html",
    "default_icon": {
      "16": "../icons/icon16.png",
      "48": "../icons/icon48.png",
      "128": "../icons/icon128.png"
    }
  },
  "options_page": "../options/options.html",
  "icons": {
    "16": "../icons/icon16.png",
    "48": "../icons/icon48.png",
    "128": "../icons/icon128.png"
  }
}
